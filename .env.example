# Source metadata only. Set the actual registry.json endpoint; no URL is guessed.
REGISTRY_URL=https://registry.example.internal/registry.json
TRINO_URL=https://trino.example.internal:8443
VAULT_ADDR=https://vault.example.internal:8200
VAULT_KV_MOUNT=secret
TRINO_VAULT_PATH=trino/test/admin
SQL_VAULT_PATH=trino/test/mysql
# Each secret contains username and password; override key names when needed.
TRINO_USER_KEY=username
TRINO_PASSWORD_KEY=password
SQL_USER_KEY=username
SQL_PASSWORD_KEY=password
SQL_CREDENTIAL_FILE=/run/trino-secrets/mysql.properties
MYSQL_SSL_MODE=VERIFY_IDENTITY
# Local/CI: provide a token through a mounted file, or VAULT_TOKEN at runtime.
VAULT_TOKEN_FILE=/run/vault/token
# Kubernetes: omit token/token-file and set VAULT_ROLE instead.
# VAULT_ROLE=trino-catalog-setup
# VAULT_AUTH_MOUNT=kubernetes
# VAULT_NAMESPACE=
# VAULT_CACERT=/certs/ca.pem
# REGISTRY_CA_BUNDLE=/certs/ca.pem
# TRINO_CA_BUNDLE=/certs/ca.pem

# Required for reporting wrappers; no implicit proc-center identity.
TRINO_PROC_CENTER=
